# Copia este archivo como .env y completa los valores reales.
# .env nunca se sube a git (ya está en .gitignore).

# Supabase - Transaction pooler (usado por la app en runtime)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase - Session pooler (usado solo por Prisma Migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generado con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"
JWT_EXPIRES_IN="7d"

PORT=3000

# Gmail SMTP (recuperación de contraseña). El usuario es la cuenta de Gmail
# completa; el password NO es tu contraseña normal, es una "Contraseña de
# aplicación" de 16 caracteres que se genera en myaccount.google.com/apppasswords
# (requiere tener activada la verificación en 2 pasos en esa cuenta).
GMAIL_USER="rcsoftware.ec@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Google Sign-In: the WEB OAuth client ID (not the Android one) from Google
# Cloud Console — this is the "audience" used to verify Google ID tokens.
GOOGLE_CLIENT_ID="xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# Firebase Admin (push notifications). El contenido COMPLETO del JSON de la
# cuenta de servicio, descargado en Firebase Console → Configuración del
# proyecto → Cuentas de servicio → Generar nueva clave privada, minificado a
# una sola línea. NUNCA compartas este valor ni lo subas a git.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"pico-y-placa-ec", ...}'
