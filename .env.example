# Copia este archivo como .env y completa los valores reales.
# .env nunca se sube a git (ya está en .gitignore).

# Supabase - Transaction pooler (usado por la app en runtime)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase - Session pooler (usado solo por Prisma Migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generado con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"
JWT_EXPIRES_IN="7d"

PORT=3000
