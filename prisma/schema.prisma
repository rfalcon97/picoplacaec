// Prisma schema — Pico y Placa EC
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Nullable because a user who signs in with Google only may never set one.
  passwordHash String?
  /// Google's stable subject id, set for users who have linked Google sign-in.
  googleId     String?   @unique
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vehicles     Vehicle[]
  resetTokens  PasswordResetToken[]
  deviceTokens DeviceToken[]
}

/// A one-time-use password reset code, emailed to the user. The code itself
/// is never stored — only its hash — so a leaked database can't be used to
/// reset accounts.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// A Firebase Cloud Messaging token for one signed-in device. A user can
/// have several (multiple devices); a token is unique across all users
/// since Firebase reissues a fresh one per install/reset.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A city with its own circulation-restriction rules. Rules are data, not code,
/// so adding a new city never requires an app release.
model City {
  id                         String           @id @default(cuid())
  slug                       String           @unique
  name                       String
  active                     Boolean          @default(true)
  allDay                     Boolean          @default(false)
  timeStart                  String?
  timeEnd                    String?
  suspendsOnNationalHolidays Boolean          @default(true)
  sourceUrl                  String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  dayRules                   DayRule[]
  dateExceptions             DateException[]
  vehicles                   Vehicle[]
}

/// Which plate last-digits are restricted on a given weekday, per city.
/// An empty `digits` array means no restriction that day.
model DayRule {
  id      String  @id @default(cuid())
  cityId  String
  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  weekday Weekday
  digits  Int[]

  @@unique([cityId, weekday])
}

/// One-off override for a specific date and city (local holiday, municipal
/// suspension, etc.). Takes precedence over the weekday DayRule and over
/// NationalHoliday for that city.
model DateException {
  id                String   @id @default(cuid())
  cityId            String
  city              City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  reason            String
  restrictionActive Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([cityId, date])
}

/// Ecuador national holidays, synced automatically from a public API.
/// A city only respects these if City.suspendsOnNationalHolidays is true,
/// and a DateException for that city+date always wins over this.
model NationalHoliday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
  year Int
}

model Vehicle {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname   String
  plateDigit Int
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])
  /// HH:mm, local device time — when to fire the SAME-DAY reminder on a
  /// restricted day itself. A separate night-before reminder is always sent
  /// too, at a fixed default time (not user-configurable).
  reminderTime String @default("20:00")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
